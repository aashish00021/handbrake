# Copy to .env and fill in. Everything runs on your machine; keys never leave it except to call the judge.

# Your OpenAI key. Used by the default judge (Decisions API) and by cli.js's own agent.
OPENAI_API_KEY=

# Judge: "decisions" (default, OpenAI Decisions API, ~0.3-0.6s, gives probabilities)
#     or "chat" (any OpenAI-compatible chat endpoint with a vision model, ~2s).
# HANDBRAKE_JUDGE=chat

# Only for HANDBRAKE_JUDGE=chat:
# HANDBRAKE_JUDGE_BASE_URL=https://api.openai.com/v1   # or https://openrouter.ai/api/v1, http://localhost:11434/v1 (Ollama)
# HANDBRAKE_JUDGE_KEY=                                  # defaults to OPENAI_API_KEY
# HANDBRAKE_JUDGE_MODEL=gpt-6.1-sol                     # any vision model the endpoint serves

# Optional
# HANDBRAKE_SAFE_CONFIDENCE=0.8   # Decisions judge: a "safe" below this still asks. Lower = fewer questions, see eval/
# HANDBRAKE_POLICY=/path/to/handbrake.json
# HANDBRAKE_HEADLESS=1
